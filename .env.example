# Copy to .env.local and fill in. All three are REQUIRED in production.

# Admin login for /admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Signs admin sessions and player tracking tokens. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Database (libSQL / SQLite).
#   Local file (VPS, Docker, local dev):  file:./data/cinemirror.db   (default)
#   Hosted (Turso — needed on serverless hosts like Vercel):  libsql://your-db.turso.io
DATABASE_URL=file:./data/cinemirror.db
DATABASE_AUTH_TOKEN=

# Set to "false" to skip inserting the demo catalogue on first start
SEED_DEMO=true

# Optional: TMDB (themoviedb.org) powers the Discover page, movie details/trailers and
# "Import from TMDB" in the admin. Free key: https://www.themoviedb.org/settings/api
# Paste either the "API Key" (v3) or the "API Read Access Token" (v4).
TMDB_API_KEY=
# Public contact details shown in the footer and on /contact, /dmca, /disclaimer (demo values used if empty)
CONTACT_EMAIL=
DMCA_EMAIL=
CONTACT_PHONE=

# Optional: player shown on /movie/<id> pages. Base URL with an {id} placeholder for the TMDB id,
# pointing at your own player or one you are licensed to embed. https only. Leave empty to hide it.
#   e.g. STREAM_EMBED_URL=https://player.your-domain.com/embed/movie/{id}
STREAM_EMBED_URL=

# Optional: player for episodes on /series/<id>. Placeholders: {id} (TMDB id), {season}, {episode}.
#   e.g. STREAM_EMBED_TV_URL=

# Background sync: every STREAM_SYNC_HOURS (default 6) the server checks the TMDB catalogues against the
# stream provider and links the titles it can play. STREAM_SYNC_PAGES = pages per list (20 titles each, default 5).
# STREAM_SYNC=off disables it. CRON_SECRET lets an external cron call POST /api/stream-sync (Bearer token).
STREAM_SYNC_HOURS=
STREAM_SYNC_PAGES=
CRON_SECRET=https://player.your-domain.com/embed/tv/{id}/{season}/{episode}
STREAM_EMBED_TV_URL=

# Optional: TMDB API host. Default https://api.tmdb.org/3 (works where ISPs block api.themoviedb.org)
TMDB_API_BASE=

# Background import of public, free-to-stream films into the ad-free native player (archive.org collections,
# Wikimedia Commons categories). Space/comma separated https links. Default: the archive.org feature_films collection.
# Films are published only when the source confirms a free licence; the rest become hidden drafts.
# PUBLIC_SYNC_HOURS (default 12), PUBLIC_SYNC_BATCHES = batches of 20 per source per run (default 1), PUBLIC_SYNC=off disables.
PUBLIC_IMPORT_SOURCES=
PUBLIC_SYNC_HOURS=
PUBLIC_SYNC_BATCHES=

# Optional: separately hosted player (the cinemirror-player project). When both are set, /watch/<slug>
# shows it in an iframe instead of the built-in player. PLAYER_KEY = an active partner key (Admin → Partners).
# The player's own VITE_API_BASE must point back at this site.
PLAYER_URL=
PLAYER_KEY=

# Local development only: add extra third-party embed servers (managed in Admin -> Servers) with a
# server switcher and a per-server "Ad Block" (sandbox) toggle to the /movie and /series players.
# Ignored when NODE_ENV=production (next build / next start), so it can never reach a deployed site.
LOCAL_EXTRA_SERVERS=
# Add, edit, re-order or hide those servers in Admin -> Servers (it also has a "Test URL" button).

# In development the background syncs (stream availability, public-domain import) are OFF to keep the dev server light.
# Turn them on with STREAM_SYNC=on / PUBLIC_SYNC=on. In production they run by default.
