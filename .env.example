# Copy to .env.local and fill in. All three are REQUIRED in production.

# Admin login for /admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Signs admin sessions and player tracking tokens. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Database (libSQL / SQLite).
#   Local file (VPS, Docker, local dev):  file:./data/cinemirror.db   (default)
#   Hosted (Turso — needed on serverless hosts like Vercel):  libsql://your-db.turso.io
DATABASE_URL=file:./data/cinemirror.db
DATABASE_AUTH_TOKEN=

# Set to "false" to skip inserting the demo catalogue on first start
SEED_DEMO=true
